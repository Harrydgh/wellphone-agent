# Optional overrides. The program normally discovers these automatically.
WELLPHONE_ADB=
WELLPHONE_SCRCPY=
WELLPHONE_SERIAL=

# Virtual display defaults used in the next milestone.
WELLPHONE_DISPLAY_SIZE=1080x1920
WELLPHONE_DISPLAY_DPI=420
WELLPHONE_BROWSER_PACKAGE=com.android.browser

# LangGraph + DeepSeek Agent. Keep the real key in your environment, never here.
DEEPSEEK_API_KEY=
WELLPHONE_DEEPSEEK_MODEL=deepseek-flash
WELLPHONE_DEEPSEEK_BASE_URL=
